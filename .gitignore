# 运行时生成的数据库（云端部署请挂持久盘，不要提交）
greenfun.db
*.db
*.db-shm
*.db-wal

# 用户上传文件（现场照片 / AI 效果图，运行时生成，不要提交）
web/uploads/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 环境变量 / 密钥（切勿提交）
.env
.env.*
*.secret

# 日志
*.log

# 系统文件
.DS_Store
Thumbs.db
nul

# 本地测试临时目录
.tmp/

# Cloudflare Tunnel 二进制（部署包内下载获得，不提交）
deploy-local/cloudflared.exe
# 隧道/服务运行日志（运行时生成）
deploy-local/*.log
deploy-local/*.err
